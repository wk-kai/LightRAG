###########################
### Server Configuration
###########################
HOST=0.0.0.0
PORT=9621
WORKING_DIR=./rag_storage

###########################
### LLM Configuration (DeepSeek — 云端，不变)
###########################
LLM_BINDING=openai
LLM_BINDING_HOST=https://api.deepseek.com
LLM_BINDING_API_KEY=your_deepseek_key_here
LLM_MODEL=deepseek-chat
MAX_ASYNC=6
LLM_TIMEOUT=240

###########################
### Embedding (本地 Ollama bge-m3 — localhost直连)
###########################
EMBEDDING_BINDING=ollama
EMBEDDING_BINDING_HOST=http://localhost:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_FUNC_MAX_ASYNC=8
EMBEDDING_BATCH_NUM=32

###########################
### Storage Backends (全部 localhost)
###########################
LIGHTRAG_GRAPH_STORAGE=Neo4JStorage
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=Superv@1

LIGHTRAG_VECTOR_STORAGE=QdrantVectorDBStorage
QDRANT_URL=http://localhost:6333

LIGHTRAG_KV_STORAGE=RedisKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=RedisDocStatusStorage
REDIS_URI=redis://:Superv%401@localhost:6379

###########################
### Document Parsing
###########################
LIGHTRAG_PARSER=*:native-eP;*:docling-eP;*:legacy-R
DOCLING_ENDPOINT=http://localhost:5001
MAX_PARALLEL_PARSE_DOCLING=4

###########################
### MinIO
###########################
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=Superv@1
MINIO_BUCKET=lightrag-images
MINIO_SECURE=false

###########################
### VLM Configuration (DeepSeek — 云端，不变)
###########################
VLM_PROCESS_ENABLE=true
VLM_LLM_BINDING=openai
VLM_LLM_BINDING_HOST=https://api.deepseek.com
VLM_LLM_BINDING_API_KEY=your_deepseek_key_here
VLM_LLM_MODEL=deepseek-chat
VLM_MAX_ASYNC_LLM=4
VLM_LLM_TIMEOUT=300

###########################
### Query Defaults
###########################
TOP_K=60
CHUNK_TOP_K=20
MAX_ENTITY_TOKENS=6000
MAX_RELATION_TOKENS=8000
MAX_TOTAL_TOKENS=30000
COSINE_THRESHOLD=0.2

###########################
### Misc
###########################
SUMMARY_LANGUAGE=Chinese
MAX_PARALLEL_INSERT=3
HF_ENDPOINT=https://hf-mirror.com
