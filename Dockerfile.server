##############################################
# LightRAG Dockerfile for 3080 Server
# Build: docker build -t lightrag-server .
##############################################
FROM python:3.12-slim

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Install uv
RUN pip install uv

# Install Bun for frontend build
RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:$PATH"

# Copy dependency files first (layer caching)
COPY pyproject.toml uv.lock ./

# Install Python dependencies
RUN uv sync --extra api --extra offline-storage --no-dev

# Copy frontend source and build
COPY lightrag_webui/package.json lightrag_webui/bun.lock* lightrag_webui/
COPY lightrag_webui/vite.config.ts lightrag_webui/tsconfig*.json lightrag_webui/index.html lightrag_webui/
COPY lightrag_webui/src/ lightrag_webui/src/
COPY lightrag_webui/public/ lightrag_webui/public/
RUN cd lightrag_webui && bun install --frozen-lockfile && bun run build && cd ..

# Copy project source
COPY lightrag/ lightrag/
COPY prompts/ prompts/
COPY .env .env

# Expose port
EXPOSE 9621

# Use host network for localhost access to other containers
CMD ["sh", "-c", ". .venv/bin/activate && python -m lightrag.api.lightrag_server"]
